{
  "name": "zombie-404",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "desktop": "electron .",
    "desktop:dist": "npm run build && electron-builder",
    "play": "node scripts/play.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.zombie404.game",
    "productName": "ZOMBIE-404",
    "files": [
      "dist/**/*",
      "desktop/main.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
